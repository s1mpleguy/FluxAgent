# 将密钥填写到复制后的 .env，勿提交真实密钥。
DMX_API_KEY=
SPRING_PROFILES_ACTIVE=deepseek
DEEPSEEK_BASE_URL=https://www.dmxapi.cn
DEEPSEEK_COMPLETIONS_PATH=/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4.1-flash-1017
# 如需主模型使用独立密钥，取消下一行注释并填写。
# DEEPSEEK_API_KEY=
JEV_ENABLED=true
JEV_BASE_URL=https://www.dmxapi.cn
JEV_MODEL=jev-latest
JEV_TIMEOUT=8s
JEV_MIN_CONFIDENCE=0.7
# 如需 Jev 使用独立密钥，取消下一行注释并填写。
# JEV_API_KEY=
REDIS_PASSWORD=echomind123
LLM_FALLBACK_ENABLED=true
# 可选 Anthropic profile：切换 SPRING_PROFILES_ACTIVE 后填写以下配置。
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
