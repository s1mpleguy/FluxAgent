{
  "uid": "fluxagent-overview",
  "title": "FluxAgent 运行监控",
  "tags": [
    "fluxagent",
    "operations"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "应用采集状态",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fluxagent-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "采集失败",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{service=\"fluxagent\",instance=~\"$instance\"})",
          "legendFormat": "应用采集状态",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fluxagent-prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "累计聊天请求",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fluxagent-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(echomind_chat_duration_seconds_count{service=\"fluxagent\",instance=~\"$instance\"})",
          "legendFormat": "累计聊天请求",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fluxagent-prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "每秒聊天请求",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fluxagent-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(echomind_chat_duration_seconds_count{service=\"fluxagent\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "每秒聊天请求",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fluxagent-prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "聊天 P95",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fluxagent-prometheus"
      },
      "description": "没有请求时暂无数据；分位数由直方图估算。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(echomind_chat_duration_seconds_bucket{service=\"fluxagent\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "聊天 P95",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fluxagent-prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "聊天请求速率",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fluxagent-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(echomind_chat_duration_seconds_count{service=\"fluxagent\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "fluxagent-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "聊天平均耗时",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fluxagent-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(echomind_chat_duration_seconds_sum{service=\"fluxagent\",instance=~\"$instance\"}[$__rate_interval])) / sum(rate(echomind_chat_duration_seconds_count{service=\"fluxagent\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "聊天平均耗时",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "fluxagent-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Agent 最低执行成功率",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fluxagent-prometheus"
      },
      "description": "所有 Agent 中的最低值，表示调用执行成功率，不表示回答正确率。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "暂无数据",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(echomind_agent_success_rate{service=\"fluxagent\",instance=~\"$instance\"} and on (instance) (sum by (instance) (fluxagent_agent_requests{service=\"fluxagent\",instance=~\"$instance\"}) > 0))",
          "legendFormat": "Agent 最低执行成功率",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fluxagent-prometheus"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
